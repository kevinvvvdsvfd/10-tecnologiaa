function esc(s){ return String(s == null ? "" : s).replace(/[&<>"']/g, function(c){ return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]; }); }
function $(s){ return document.querySelector(s); }
function $$(s){ return Array.prototype.slice.call(document.querySelectorAll(s)); }

/* ---------- Navegación ---------- */
var current = "innovacion";
function renderSteps(){
  var h = "";
  SECTIONS.forEach(function(s, i){
    var done = (s.id === "taller" && countFilled().done === countFilled().total) || (s.id === "quiz" && state.q.sent);
    h += '<button class="step" data-go="'+s.id+'" aria-current="'+(s.id===current)+'"><span class="n">'+(i+1)+'</span>'+s.name+(done?' <span class="done">✓</span>':'')+'</button>';
  });
  $("#steps").innerHTML = h;
}
function go(id){
  current = id;
  SECTIONS.forEach(function(s){ document.getElementById("sec-"+s.id).hidden = (s.id !== id); });
  renderSteps();
  window.scrollTo(0,0);
}
document.addEventListener("click", function(e){
  var b = e.target.closest("[data-go]");
  if(b){ go(b.getAttribute("data-go")); }
});

/* ---------- Clasificador ---------- */
function renderSorter(){
  var h = "";
  SORT.forEach(function(it, i){
    var pick = state.sort[i];
