    if(pick){ var ok = pick === it.a;
      fb = '<div class="fb '+(ok?"ok":"bad")+'">'+(ok?"Correcto. ":"No es "+esc(pick).toLowerCase()+". ")+esc(it.why)+'</div>'; }
    h += '<div class="sort-item"><p>'+esc(it.t)+'</p><div class="btns">'+
