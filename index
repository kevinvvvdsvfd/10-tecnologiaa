  if(!b) return;
  state.sort[b.getAttribute("data-sort")] = b.getAttribute("data-pick");
  save(); renderSorter();
});

/* ---------- Taller ---------- */
function allFields(){ var f = []; TALLER.forEach(function(it){ if(it.fields) it.fields.forEach(function(x){ f.push(x); }); }); return f; }
function countFilled(){ var f = allFields(); var d = 0; f.forEach(function(x){ if((state.t[x.id]||"").trim().length >= 3) d++; }); return {done:d, total:f.length}; }

function renderTaller(){
  var h = "";
