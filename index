    '.en{margin:0;color:#55665E}.caso{margin:0;background:#E6EEE9;padding:10px 12px;border-radius:6px;font-size:14px}'+
    '.qa{display:grid;gap:3px}.ql{font-weight:600;font-size:14px}.ans{white-space:pre-wrap;background:#F8FAF9;border-left:3px solid #9A6B0C;padding:8px 10px;border-radius:0 6px 6px 0}.ans.empty{color:#B3261E;font-style:italic}'+
    '.grade{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-start;background:#F5EACB;padding:10px 12px;border-radius:6px}.grade label{display:grid;gap:3px;font-weight:600;font-size:13px}.grade .cm{flex:1;min-width:200px}'+
    'input.p{width:90px;font-size:18px;padding:6px 8px;border:1px solid #9A6B0C;border-radius:6px}textarea{font:inherit;padding:6px 8px;border:1px solid #CAD7CF;border-radius:6px;width:100%;box-sizing:border-box}'+
    '.tb{overflow-x:auto;background:#fff;border:1px solid #CAD7CF;border-radius:8px}table{border-collapse:collapse;width:100%;min-width:600px;font-size:14px}th,td{padding:8px 10px;border-bottom:1px solid #E1E9E4;text-align:left;vertical-align:top}th{background:#E6EEE9}'+
    'td.ok{color:#2E7D4F;font-weight:700;font-size:18px}td.no{color:#B3261E;font-weight:700;font-size:18px}'+
    '.bar{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}.bar button{font:inherit;font-weight:700;padding:9px 16px;border-radius:6px;border:1px solid #2E6B45;background:#2E6B45;color:#fff;cursor:pointer}.bar button.g{background:#fff;color:#2E6B45}'+
    '.note{font-size:13px;color:#55665E}.final{margin-top:12px;font-size:15px}'+
    '@media print{.bar,.note{display:none}body{background:#fff}.it,.sum,header.doc{break-inside:avoid}}';

  var js = '(function(){var QC='+c+',NI=8;'+
    'function lvl(n){return n>=4.6?"Superior":n>=4.0?"Alto":n>=3.0?"Básico":"Bajo";}'+
