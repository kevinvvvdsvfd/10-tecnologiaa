var lastUrl = null;
function makeUrl(){
  if(lastUrl) URL.revokeObjectURL(lastUrl);
  lastUrl = URL.createObjectURL(new Blob([buildReport()], {type:"text/html;charset=utf-8"}));
  return lastUrl;
}
function check(){
  var problems = [];
  if(state.est.nombre.trim().length < 5) problems.push("escribe tu nombre completo");
  if(!state.est.grupo.trim()) problems.push("escribe tu grupo");
  return problems;
}
function warnings(){
  var w = [], c = countFilled();
  if(c.done < c.total) w.push("te faltan "+(c.total-c.done)+" respuestas del taller");
  if(!state.q.sent) w.push("no has enviado el quiz");
  return w;
}
$("#dl").addEventListener("click", function(){
  var p = check();
  if(p.length){ $("#dl-msg").innerHTML = '<p class="msg bad">Antes de descargar, '+p.join(" y ")+'.</p>'; return; }
  var a = document.createElement("a"); a.href = makeUrl(); a.download = fileName();
  document.body.appendChild(a); a.click(); a.remove();
  var w = warnings();
  $("#dl-msg").innerHTML = '<p class="msg ok">Se descargó <b>'+esc(fileName())+'</b>. Búscalo en la carpeta Descargas.'+(w.length?' Ojo: '+w.join(" y ")+'. Si completas lo que falta, vuelve a descargar.':'')+'</p>';
});
$("#open").addEventListener("click", function(){
  var p = check();
  if(p.length){ $("#dl-msg").innerHTML = '<p class="msg bad">Antes de abrir el archivo, '+p.join(" y ")+'.</p>'; return; }
  var win = window.open(makeUrl(), "_blank");
  if(!win) $("#dl-msg").innerHTML = '<p class="msg bad">El navegador bloqueó la pestaña nueva. Permite las ventanas emergentes para esta página e intenta otra vez.</p>';
});
$("#reset").addEventListener("click", function(){ $("#reset-row").hidden = true; $("#reset-confirm").hidden = false; });
$("#reset-no").addEventListener("click", function(){ $("#reset-row").hidden = false; $("#reset-confirm").hidden = true; });
$("#reset-yes").addEventListener("click", function(){
  try{ localStorage.removeItem(KEY); }catch(e){}
  state = {est:{nombre:"",grupo:"",fecha:todayISO()}, t:{}, q:{ans:[], sent:false}, sort:{}};
  ["#est-nombre","#est-grupo"].forEach(function(s){ $(s).value = ""; }); $("#est-fecha").value = state.est.fecha;
  renderSorter(); renderTaller(); renderQuiz(); $("#quiz-msg").innerHTML = ""; $("#dl-msg").innerHTML = '<p class="msg ok">Respuestas borradas. El computador quedó listo para el siguiente estudiante.</p>';
  $("#reset-row").hidden = false; $("#reset-confirm").hidden = true;
  save(); renderSteps();
});

